---
import Container from "@/components/container.astro";
import Pagetitle from "@/components/pagetitle.astro";
import Layout from "@/layouts/Layout.astro";
import { pressItems } from "@/data/press";
---

<Layout title="Press">
  <Container>
    <Pagetitle>
      <Fragment slot="title">Press</Fragment>
      <Fragment slot="desc">Art Exhibitions & Press Releases</Fragment>
    </Pagetitle>
    <main class="mt-10">
      <div class="grid gap-10 md:grid-cols-2 lg:gap-10">
        {pressItems.map((item) => (
          <a
            href={item.url}
            target="_blank"
            rel="noopener noreferrer"
            class="group cursor-pointer overflow-hidden rounded-md transition-all hover:shadow-lg dark:hover:shadow-gray-800"
          >
            <div class="overflow-hidden rounded-md bg-gray-100 dark:bg-gray-800">
              <img
                src={item.image}
                alt={item.title}
                class="aspect-video w-full object-cover transition-all group-hover:scale-105"
                loading="lazy"
              />
            </div>
            <div class="mt-4 px-1">
              <h2 class="text-lg font-semibold leading-snug tracking-tight text-gray-800 dark:text-white">
                {item.title}
              </h2>
            </div>
          </a>
        ))}
      </div>
    </main>
  </Container>
</Layout>